#   python third_party/sam31_runtime/scripts/download_checkpoint.py --source hf
third_party/sam31_runtime/checkpoints/**/*.pt
third_party/sam31_runtime/sam31_video_test/
third_party/sam31_runtime/sam31_video_refine_test/
third_party/sam31_runtime/sam31_*.jpg

